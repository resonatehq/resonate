---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const quickstart = `${import.meta.env.BASE_URL}docs/get-started/quickstart/`;
const steps = [
  { title: 'Write a function', text: 'Use TypeScript, Python, Rust, Go, or Java. The quickstart uses a countdown that sleeps between steps.', anchor: 'write-a-function' },
  { title: 'Run it', text: 'Start a worker and invoke the function with an execution ID. Use that ID to inspect the call graph.', anchor: 'run-the-function' },
  { title: 'Restart the worker', text: 'Stop the worker mid-countdown. Start it again and watch the same execution pick up where it stopped.', anchor: 'what-to-try' },
];
---
<StarlightPage frontmatter={{
  title: 'Durable execution with Resonate', template: 'splash',
  description: 'Write a function, run it, and see it resume after a worker restart.',
  hero: {
    title: 'Functions that survive restarts.',
    tagline: 'Resonate is an open-source durable execution platform. It records completed steps so a worker can stop, restart, and continue the same execution.',
    actions: [
      { text: 'Run the quickstart', link: quickstart, icon: 'right-arrow' },
      { text: 'Browse the full docs', link: 'https://docs.resonatehq.io/', variant: 'secondary' },
    ],
  },
}}>
  <section class="walkthrough not-content" aria-labelledby="walkthrough-heading">
    <p class="eyebrow">Inside the quickstart</p>
    <h2 id="walkthrough-heading">One countdown, from start to restart.</h2>
    <ol>
      {steps.map(({ title, text, anchor }, i) => <li>
        <span class="step" aria-hidden="true">0{i + 1}</span>
        <h3><a href={`${quickstart}#${anchor}`}>{title}</a></h3>
        <p>{text}</p>
      </li>)}
    </ol>
  </section>
</StarlightPage>
<style>
  .walkthrough { border-top: 1px solid var(--sl-color-hairline); padding: 2rem 0 1rem; }
  .eyebrow, .step { color: var(--sl-color-gray-2); font: 600 .75rem/1.5 var(--sl-font-mono); }
  .eyebrow { text-transform: uppercase; letter-spacing: .1em; }
  h2 { color: var(--sl-color-white); font-size: clamp(1.45rem, 3vw, 2rem); margin: .5rem 0 1.75rem; }
  ol { padding: 0; margin: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1.5rem; }
  li { border-top: 1px solid var(--sl-color-hairline); padding-top: 1rem; }
  h3 { font-size: 1.125rem; margin: .5rem 0; }
  h3 a { color: var(--sl-color-white); text-underline-offset: .2em; }
  li p { color: var(--sl-color-gray-2); font-size: .95rem; line-height: 1.65; }
</style>
